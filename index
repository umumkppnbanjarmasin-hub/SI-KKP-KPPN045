  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #2C200E;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Layar pemuat awal sebelum Google Apps Script selesai render */
    #splash-screen {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2C200E 0%, #4A3516 50%, #23190B 100%);
      color: #FFF9EB;
      z-index: 10;
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    #splash-screen.fade-out {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .gold-spinner {
      width: 44px;
      height: 44px;
      border: 3.5px solid rgba(246, 226, 159, 0.25);
      border-top-color: #E5BD5B;
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
      margin-bottom: 14px;
    }

    .splash-title {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #F6E29F;
    }

    .splash-sub {
      font-size: 12px;
      color: #D8C59E;
      margin-top: 4px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Frame penuh tanpa border */
    iframe#app-frame {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      display: block;
      background-color: #FAF8F3;
    }
  </style>
</head>
<body>

  <div id="splash-screen">
